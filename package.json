{
  "name": "vora-desktop",
  "productName": "Vora",
  "version": "1.0.0",
  "description": "The Windows and Linux app for a Vora media server",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.pages.json",
    "fetch-mpv": "node --experimental-strip-types scripts/fetch-mpv-windows.mts",
    "build-icons": "node --experimental-strip-types scripts/build-icons.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "electron": "^44.9.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.11"
  }
}
